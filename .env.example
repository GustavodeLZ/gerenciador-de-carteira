# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# CONFIRA que os valores são do projeto Supabase PESSOAL, não do trabalho.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta (sb_secret_... ou service_role). NUNCA com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# brapi.dev > Dashboard > token
BRAPI_TOKEN=xxx

# finnhub.io > Dashboard > API key (gratuito). Cotações de ações americanas.
FINNHUB_TOKEN=xxx

# Qualquer texto aleatório longo (ex.: openssl rand -hex 32). Protege a rotina diária.
CRON_SECRET=troque-por-um-valor-aleatorio
